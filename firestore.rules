rules_version = '2';
// ═════════════════════════════════════════════════════════════════════════
// Reglas de seguridad de Solibook — cargos, atribuciones y trazabilidad.
//
// Se publican en: Firebase Console → Firestore Database → Reglas
// o con: firebase deploy --only firestore:rules
//
// IDEA CENTRAL: el cargo dice quién es la persona (y con qué nombre firma);
// las atribuciones sólo SUMAN capacidades, nunca quitan. Estas reglas repiten
// el criterio de `src/lib/permisos.ts` y `src/lib/atributos.ts`: si acá y allá
// se contradicen, gana la app en la apariencia y la regla en el acceso.
//
// Cargos vigentes:
//   Desarrollador     → acceso absoluto, incluidas las cuentas de Director.
//   Director fundador → rol Director + uid en configuracion/estado.fundador:
//                       administra cuentas como Desarrollador sin cambiar rol.
//   Director          → todo excepto eliminar o modificar cuentas de nivel
//                       Director o Desarrollador.
//   Secretario        → todo excepto administrar cuentas y roles.
//   Vocal             → agenda, listas, justificativos (aprueba), fichas,
//                       leer cartas y actas, acusar recibo, firmar el cupo
//                       opcional de Vocalía, métricas. NO libro de documentos,
//                       NO registrar/corregir cartas, NO redactar actas, NO
//                       pantalla de cuentas, NO autoriza borrados, NO ocupa el
//                       cupo de Dirección.
//   Tesorero          → leer todo, acusar recibo, crear/editar fichas,
//                       justificar por otros, libro de documentos completo y el
//                       cupo de Tesorería en las actas. NO agenda ni listas, NO
//                       métricas, NO redacta ni borra actas, NO aprueba
//                       justificativos, NO cuentas, NO aprueba ingresos, y nunca
//                       autoriza un borrado por sí solo.
//   Administrativo     → anota la operación (agenda, listas, cartas, actas en
//                       borrador, fichas, documentos, justificativos) pero no la
//                       cierra: no cierra listas ni actas, no acusa recibo, no
//                       aprueba justificativos, no borra nada, no ve cuentas.
//   Miembro            → su calendario y sus justificativos. Lee sólo su ficha.
//
// Altas: una cuenta nueva nace 'Pendiente' y no puede leer nada del ministerio
// hasta que Dirección o Secretaría la aceptan. Ese filtro vive en
// `cuentaVigente()`, que es la base de toda escritura de datos compartidos.
//
// Migración: 'Administrador' → 'Director', 'Secretaria' → 'Secretario',
// 'Directiva' → 'Administrativo'. Se normaliza al leer, sin reescribir datos.
// ═════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────── Sesión, cargo y atribuciones ─────────────────────

    function autenticado() {
      return request.auth != null;
    }

    function rutaUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function rutaFicha(id) {
      return /databases/$(database)/documents/integrantes/$(id);
    }

    function rutaEstado() {
      return /databases/$(database)/documents/configuracion/estado;
    }

    function perfil() {
      return get(rutaUsuario(request.auth.uid)).data;
    }

    // Cuenta que existe y no está suspendida. Basta para la autopista de datos
    // propios (ajustes, tokens de push, ficha propia), no para los libros.
    function activo() {
      return autenticado()
        && exists(rutaUsuario(request.auth.uid))
        && perfil().get('activo', false) == true;
    }

    // Cargo vigente, con los valores antiguos traducidos al vuelo.
    function rolDe(p) {
      let r = p.get('rol', '');
      return r == 'Administrador' ? 'Director'
        : r == 'Secretaria' ? 'Secretario'
        : r == 'Directiva' ? 'Administrativo'
        : r;
    }

    function rolActual() {
      return rolDe(perfil());
    }

    function esFundador() {
      return exists(rutaEstado())
        && get(rutaEstado()).data.get('fundador', '') == request.auth.uid;
    }

    // Alta aceptada. Las cuentas anteriores a este flujo no traen el campo y ya
    // estaban dadas de alta; una cuenta Pendiente, Rechazada o 'Sin respuesta'
    // no puede tocar nada del ministerio.
    function altaAceptada(p) {
      return p.get('estadoIngreso', 'Aceptado') == 'Aceptado';
    }

    function cuentaVigente() {
      return activo() && altaAceptada(perfil());
    }

    // Atribución vigente de un perfil: sin `hasta` no vence; si venció, la
    // firma que ya puso en una solicitud pendiente caduca con ella.
    function atribucionVigente(p, nombre) {
      return nombre != ''
        && p.get('atribuciones', []).exists(a,
             a.get('atributo', '') == nombre
             && (a.get('hasta', '') == '' || timestamp(a.get('hasta', '')) > request.time));
    }

    function tieneAtribucion(nombre) {
      return atribucionVigente(perfil(), nombre);
    }

    function cargoEn(lista) {
      return cuentaVigente() && rolActual() in lista;
    }

    // Desarrollador o Director fundador: la llave de todo.
    function esSuperAdmin() {
      return cargoEn(['Desarrollador']) || (cargoEn(['Director']) && esFundador());
    }

    // Capacidad = cuenta vigente y (cargo que la incluye o atribución que la
    // suma). `esSuperAdmin()` entra siempre: su acceso es absoluto.
    function puede(cargos, atributo) {
      return esSuperAdmin() || cargoEn(cargos) || (cuentaVigente() && tieneAtribucion(atributo));
    }

    // Gestión diaria: todo cargo salvo Miembro.
    function esGestion() {
      return cuentaVigente()
        && rolActual() in ['Director', 'Secretario', 'Tesorero', 'Vocal', 'Administrativo', 'Desarrollador'];
    }

    // ─────────────────────────── Capacidades ───────────────────────────

    function puedeAgenda() {
      return puede(['Director', 'Secretario', 'Vocal', 'Administrativo'], 'gestionar_agenda');
    }

    function puedeQuitarActividad() {
      return puede(['Director', 'Secretario', 'Vocal'], 'eliminar_agenda');
    }

    function puedePasarListas() {
      return puede(['Director', 'Secretario', 'Vocal', 'Administrativo'], 'gestionar_listas');
    }

    // Cerrar la lista es lo que la vuelve registro: el Ayudante no lo hace.
    function puedeCerrarListas() {
      return puede(['Director', 'Secretario', 'Vocal'], 'cerrar_listas');
    }

    function puedeJustificativos() {
      return puede(['Director', 'Secretario', 'Tesorero', 'Vocal', 'Administrativo'], '');
    }

    function puedeResolverJustificativos() {
      return puede(['Director', 'Secretario', 'Vocal'], 'resolver_justificaciones');
    }

    function puedeVerCorrespondencia() {
      return puede(['Director', 'Secretario', 'Tesorero', 'Vocal', 'Administrativo'], '');
    }

    // Registrar cartas y corregirlas: Secretaría y Dirección (y quien reciba la
    // atribución). El Vocal lee y acusa, pero no escribe en el libro.
    function puedeGestionarCartas() {
      return puede(['Director', 'Secretario', 'Administrativo'], 'gestionar_cartas');
    }

    function puedeAcusarRecibo() {
      return puede(['Director', 'Secretario', 'Tesorero', 'Vocal'], 'acuse_recibo');
    }

    function puedeVerActas() {
      return puede(['Director', 'Secretario', 'Tesorero', 'Vocal', 'Administrativo'], '');
    }

    // Redactar y guardar actas. Cerrarlas no: eso producen las firmas de cupo.
    function puedeRedactarActas() {
      return puede(['Director', 'Secretario', 'Administrativo'], 'gestionar_actas');
    }

    function puedeVerDocumentos() {
      return puede(['Director', 'Secretario', 'Tesorero'], 'ver_documentos');
    }

    function puedeSubirDocumentos() {
      return puede(['Director', 'Secretario', 'Tesorero', 'Administrativo'], 'subir_documentos');
    }

    // Borrar del libro de documentos exige doble firma (Dirección + Secretaría)
    // y se ejecuta desde /api/eliminaciones; ningún cliente borra aquí.
    function puedeFichas() {
      return puede(['Director', 'Secretario', 'Tesorero', 'Vocal', 'Administrativo'], '');
    }

    function puedeVerCuentas() {
      return puede(['Director', 'Secretario'], 'ver_cuentas');
    }

    // Altas: aceptar, vincular o rechazar una cuenta que llega.
    function puedeAprobarIngresos() {
      return puede(['Director', 'Secretario'], 'aprobar_ingresos');
    }

    // ──────────────────────────── Usuarios ────────────────────────────

    function rolValido(rol) {
      return rol in ['Director', 'Secretario', 'Tesorero', 'Vocal', 'Administrativo', 'Directiva', 'Miembro', 'Desarrollador', 'Administrador', 'Secretaria'];
    }

    // Una cuenta que se edita a sí misma no se toca la seguridad: rol, estado,
    // ficha vinculada, atribuciones, ofertas de cargo y constancias quedan tal
    // cual. Sin esta comparación, una cuenta Pendiente podría aceptarse sola.
    function sinTocarSeguridad() {
      let antes = resource.data;
      let despues = request.resource.data;
      return antes.get('activo', false) == despues.get('activo', false)
        && antes.get('rol', '') == despues.get('rol', '')
        && antes.get('estadoIngreso', 'Aceptado') == despues.get('estadoIngreso', 'Aceptado')
        && antes.get('integranteId', '') == despues.get('integranteId', '')
        && antes.get('atribuciones', []) == despues.get('atribuciones', [])
        && antes.get('ofertaDirector', {}) == despues.get('ofertaDirector', {})
        && antes.get('ofertaDirectorEmitida', {}) == despues.get('ofertaDirectorEmitida', {})
        && antes.get('ultimoTraspaso', {}) == despues.get('ultimoTraspaso', {})
        && antes.get('aceptadoPor', {}) == despues.get('aceptadoPor', {});
    }

    // Aceptar un ingreso: sólo Dirección/Secretaría, sólo sobre una cuenta
    // Pendiente, y sólo los campos del alta. El vínculo a la ficha lo decide una
    // persona mirando la pantalla de Cuentas; la unicidad de la ficha la
    // revisa la app (y la ficha, si no existía, se crea acá arriba).
    function aceptarIngresoValido() {
      let antes = resource.data;
      let despues = request.resource.data;
      return puedeAprobarIngresos()
        && antes.get('estadoIngreso', 'Pendiente') == 'Pendiente'
        && antes.get('activo', false) == true
        && despues.get('estadoIngreso', '') == 'Aceptado'
        && despues.get('rol', '') == 'Miembro'
        && despues.get('activo', false) == true
        && despues.get('atribuciones', []) == antes.get('atribuciones', [])
        && despues.diff(antes).affectedKeys()
             .hasOnly(['estadoIngreso', 'rol', 'integranteId', 'aceptadoPor', 'ultimoAcceso']);
    }

    // Rechazar: se marca el estado y se suspende; nada más cambia.
    function rechazarIngresoValido() {
      let antes = resource.data;
      let despues = request.resource.data;
      return puedeAprobarIngresos()
        && antes.get('estadoIngreso', 'Pendiente') == 'Pendiente'
        && despues.get('estadoIngreso', '') == 'Rechazado'
        && despues.get('activo', true) == false
        && despues.diff(antes).affectedKeys().hasOnly(['estadoIngreso', 'activo', 'ultimoAcceso']);
    }

    // Vincular ficha y cuenta, en cualquier orden (desde Cuentas o desde la
    // ficha). La unicidad la revisa la app: al robar un vínculo se limpia el anterior.
    function vinculoValido() {
      let antes = resource.data;
      let despues = request.resource.data;
      return puedeAprobarIngresos()
        && despues.diff(antes).affectedKeys().hasOnly(['integranteId', 'ultimoAcceso']);
    }

    // Atribuciones: las concede sólo quien opera como Desarrollador, y se
    // escriben en bloque (otorgar o retirar), nunca como parte de otro cambio.
    function atribucionesValidas() {
      let antes = resource.data;
      let despues = request.resource.data;
      return esSuperAdmin()
        && despues.diff(antes).affectedKeys().hasOnly(['atribuciones', 'ultimoAcceso'])
        && despues.get('atribuciones', []).size() <= 12
        && despues.get('atribuciones', []).all(a,
             type(a) == 'string'
             || (a.get('atributo', '') in ['gestionar_agenda', 'eliminar_agenda', 'gestionar_listas', 'cerrar_listas',
               'gestionar_cartas', 'gestionar_actas', 'ver_documentos', 'subir_documentos', 'acuse_recibo',
               'resolver_justificaciones', 'ver_metricas', 'ver_cuentas', 'solicitar_borrados', 'eliminar_documento',
               'eliminar_ficha', 'cupo_direccion', 'cupo_secretaria', 'cupo_tesoreria']
               && a.get('otorgadoPor', {}).get('uid', '') != ''));
    }

    match /usuarios/{uid} {
      // Su propia cuenta, siempre: es lo único que necesita quien llega con su
      // Gmail y todavía está a la espera.
      allow get: if autenticado();
      // El padrón completo (correos, atribuciones, ofertas) sólo para quien
      // administra cuentas o acepta ingresos. La app no lo necesita en ningún
      // otro lado: los nombres del directorio salen de `integrantes`.
      allow list: if puedeVerCuentas() || puedeAprobarIngresos() || esSuperAdmin();

      // Alta de la propia cuenta: activa, rol Miembro y Pendiente de aprobación.
      // La única excepción es la cuenta fundadora, que se reclama antes en
      // configuracion/estado (transacción atómica) y nace como Director.
      // Nadie se crea con atribuciones ni con ofertas de cargo encima.
      allow create: if autenticado() && request.auth.uid == uid
        && request.resource.data.get('activo', false) == true
        && rolValido(request.resource.data.get('rol', ''))
        && !('atribuciones' in request.resource.data)
        && !('ofertaDirector' in request.resource.data)
        && !('ofertaDirectorEmitida' in request.resource.data)
        && !('ultimoTraspaso' in request.resource.data)
        && (
          (
            request.resource.data.get('rol', '') == 'Miembro'
            && request.resource.data.get('estadoIngreso', 'Pendiente') == 'Pendiente'
          )
          || (
            esFundador()
            && request.resource.data.get('rol', '') == 'Director'
            && request.resource.data.get('estadoIngreso', '') == 'Aceptado'
          )
        );

      allow update: if
        // 1) Desarrollador y Director fundador: cualquier cuenta.
        esSuperAdmin()
        // 2) Un Director no fundador administra cuentas NO superiores y jamás
        //    nombra Director ni Desarrollador.
        || (
          cargoEn(['Director'])
          && !esFundador()
          && rolDe(resource.data) in ['Secretario', 'Tesorero', 'Vocal', 'Administrativo', 'Miembro']
          && rolDe(request.resource.data) in ['Secretario', 'Tesorero', 'Vocal', 'Administrativo', 'Miembro']
        )
        // 3) La propia cuenta: datos de sesión, sin tocar la seguridad.
        || (autenticado() && request.auth.uid == uid && sinTocarSeguridad())
        // 4) El alta de quien llega (aceptar, rechazar o vincular ficha).
        || aceptarIngresoValido()
        || rechazarIngresoValido()
        || vinculoValido()
        // 5) Atribuciones concedidas por quien opera como Desarrollador.
        || atribucionesValidas();

      // Las cuentas se suspenden, no se borran: el historial conserva la autoría.
      allow delete: if false;
    }

    // Alias, preferencias y lecturas: privados incluso frente a otros cargos.
    match /usuarios/{uid}/privado/{documento} {
      allow read, write: if activo() && request.auth.uid == uid
        && documento in ['ajustes', 'lecturas'];
    }

    // Avisos dirigidos: el contenido lo escribe el servidor (o la app dentro del
    // propio documento de notificaciones). Cada cuenta lee su bandeja.
    match /usuarios/{uid}/avisos/{id} {
      allow read: if activo() && request.auth.uid == uid;
      // El aviso de la oferta de cargo lo crea /api/cargos con credenciales de
      // Admin; desde el cliente no se fabrican avisos ajenos.
      allow write: if false;
    }

    // ───────────────────────── Configuración ─────────────────────────

    match /configuracion/{documento} {
      allow read: if autenticado();
      // Cualquier sesión puede crear docs de configuración: la app los siembra y
      // la persona fundadora reclama "estado" en una transacción atómica. Ese
      // reclamo es la única escritura que admite sobre "estado".
      allow create: if autenticado();
      // "estado" guarda el reclamo de fundador: sólo el Desarrollador lo toca.
      allow update: if esSuperAdmin()
        || (documento != 'estado' && esGestion());
      allow delete: if false;
    }

    // ───────────────────── Agenda y asistencia ─────────────────────

    // Miembro incluido: el calendario es su vista.
    match /eventos/{id} {
      allow read: if activo();
      // Crear y editar la actividad: Director, Secretaría, Vocal y el Ayudante.
      allow create: if puedeAgenda();
      // Borrar una actividad es inmediato (no pasa por doble firma), pero no lo
      // hace cualquiera: el Ayudante del libro no borra.
      allow delete: if puedeQuitarActividad();
      // Cerrar la lista de un evento escribe `listaCerradaPor` en el evento; ese
      // campo y sólo ese pide la capacidad de cierre.
      allow update: if puedeAgenda()
        && (
          request.resource.data.get('listaCerradaPor', '') == resource.data.get('listaCerradaPor', '')
          || puedeCerrarListas()
        );
    }

    match /asistencias/{id} {
      // Cada quien lee su propia marca; el paso de lista completo es de gestión.
      allow read: if esGestion()
        || (activo() && perfil().get('integranteId', '') != ''
             && resource.data.get('integranteId', '') == perfil().get('integranteId', ''));
      allow write: if puedePasarListas();
    }

    // ──────────────────────── Justificativos ────────────────────────

    match /justificaciones/{id} {
      allow read: if esGestion()
        || (activo() && perfil().get('integranteId', '') != ''
             && perfil().get('integranteId', '') == resource.data.get('integranteId', ''));
      // Los envíos nuevos pasan por /api/justificaciones: allí se verifican
      // convocatoria, futuro, autoría y duplicados antes del commit atómico.
      allow create: if false;
      // Contenido: quien lleva el libro de justificativos. Cambiar la resolución
      // (aprobar/rechazar): sólo Dirección, Secretaría, Vocal o con atribución.
      // Marcar `vistoPor`: quien puede acusar recibo. La autoría del envío la
      // pone el servidor y no se reescribe.
      allow update: if puedeJustificativos()
        && (
          request.resource.data.get('estado', '') == resource.data.get('estado', '')
          || puedeResolverJustificativos()
        )
        && (
          request.resource.data.get('vistoPor', []) == resource.data.get('vistoPor', [])
          || puedeAcusarRecibo()
        )
        && (
          request.resource.data.get('creadoPorUid', '') == resource.data.get('creadoPorUid', '')
        )
        && (
          request.resource.data.get('resueltaPorUid', '') == resource.data.get('resueltaPorUid', '')
          || puedeResolverJustificativos()
        );
      // Los justificativos no forman parte del doble firma de libros: los borra
      // quien puede resolverlos, y la autoría del envío queda en el historial.
      allow delete: if puedeResolverJustificativos();
    }

    // ───────────────────────────── Libros ─────────────────────────────
    // Nadie borra un registro de libro desde el cliente: el borrado se pide, se
    // autoriza con dos cuentas distintas en /api/eliminaciones y recién allí se
    // elimina. Por eso `allow delete: if false` en los cuatro libros.

    // La foto de perfil viaja en Base64 (~30-60 KB) dentro del documento;
    // se topa a ~950 KB para proteger el límite de 1 MB por documento.
    function fotoValida() {
      return !('fotoUrl' in request.resource.data)
        || request.resource.data.fotoUrl.size() <= 950000;
    }

    function sinEliminacionPendiente(coleccion, id) {
      let clave = coleccion + '__' + id;
      return !exists(/databases/$(database)/documents/bloqueos_eliminacion/$(clave));
    }

    function noEliminado(coleccion, id) {
      let clave = coleccion + '__' + id;
      return !exists(/databases/$(database)/documents/registros_eliminados/$(clave));
    }

    match /solicitudes_eliminacion/{id} {
      allow read: if esGestion();
      allow write: if false;
    }

    match /bloqueos_eliminacion/{id} {
      allow read: if esGestion();
      allow write: if false;
    }

    // Auditoría, tombstones y cola de avisos: sólo el servidor las escribe.
    match /registros_eliminados/{id} {
      allow read: if esGestion();
      allow write: if false;
    }

    match /cola_avisos/{id} {
      allow read: if false;
      allow write: if false;
    }

    // ── Libro de fichas ──
    match /integrantes/{id} {
      allow get: if esGestion()
        || (activo() && perfil().get('integranteId', '') != '' && perfil().get('integranteId', '') == id);
      allow list: if puedeFichas();
      allow create: if puedeFichas() && fotoValida() && noEliminado('integrantes', id);
      allow update: if puedeFichas() && fotoValida() && sinEliminacionPendiente('integrantes', id);
      allow delete: if false;
    }

    // ── Libro de correspondencia ──
    // Un update que sólo agrega acuses: mismo asunto, mismo cuerpo, mismo estado,
    // y `vistoPor` más largo que antes.
    function soloAcuse() {
      let antes = resource.data;
      let despues = request.resource.data;
      return puedeAcusarRecibo()
        && despues.get('asunto', '') == antes.get('asunto', '')
        && despues.get('descripcion', '') == antes.get('descripcion', '')
        && despues.get('folio', '') == antes.get('folio', '')
        && despues.get('registradaPor', {}) == antes.get('registradaPor', {})
        && despues.get('estado', '') == antes.get('estado', '')
        && despues.get('ultimaEdicion', {}) == antes.get('ultimaEdicion', {})
        && despues.get('vistoPor', []).size() >= antes.get('vistoPor', []).size();
    }

    function contenidoCartaValido() {
      let antes = resource.data;
      let despues = request.resource.data;
      // Quien registra no reescribe la autoría de quien registró antes.
      return !('registradaPor' in antes)
        || despues.get('registradaPor', {}) == antes.get('registradaPor', {});
    }

    match /cartas/{id} {
      allow read: if puedeVerCorrespondencia();
      allow create: if puedeGestionarCartas() && noEliminado('cartas', id);
      allow delete: if false;
      // El acuse de recibo se suma, no se borra: sólo crece la lista `vistoPor`.
      // La corrección del texto (Secretaría) y el pedido de re-acuse requieren
      // gestionar la carta; quien acusa no puede cambiar el contenido.
      allow update: if sinEliminacionPendiente('cartas', id)
        && (
          (puedeGestionarCartas() && contenidoCartaValido())
          || soloAcuse()
        );
    }

    // ── Libro de actas ──
    // Tres cupos obligatorios (Dirección, Secretaría, Tesorería) y uno opcional
    // (Vocalía). El acta se cierra sola cuando las tres cuentas distintas firman,
    // y para editarla hace falta la autorización de Dirección Y Secretaría.

    function camposDeFirma() {
      return ['estado', 'version', 'firmas',
        'aprobadoPresidente', 'aprobadoSecretaria', 'aprobadoTesoreria', 'aprobadoVocalia',
        'firmaEdicionDirectorUid', 'firmaEdicionSecretarioUid', 'firmaEdicionTesoreroUid', 'firmaEdicionVocalUid',
        'editadaPor', 'edicionAutorizadaPor'];
    }

    // Los campos espejo tienen que decir lo mismo que el mapa `firmas`: sin esta
    // coherencia alguien podría marcar `aprobadoPresidente: true` sin firmar.
    function espejosCoherentes(d) {
      let f = d.get('firmas', {});
      return d.get('aprobadoPresidente', false) == (f.get('Director', {}).get('uid', '') != '')
        && d.get('aprobadoSecretaria', false) == (f.get('Secretario', {}).get('uid', '') != '')
        && d.get('aprobadoTesoreria', false) == (f.get('Tesorero', {}).get('uid', '') != '')
        && d.get('aprobadoVocalia', false) == (f.get('Vocal', {}).get('uid', '') != '')
        && d.get('firmaEdicionDirectorUid', '') == f.get('Director', {}).get('uid', '')
        && d.get('firmaEdicionSecretarioUid', '') == f.get('Secretario', {}).get('uid', '')
        && d.get('firmaEdicionTesoreroUid', '') == f.get('Tesorero', {}).get('uid', '')
        && d.get('firmaEdicionVocalUid', '') == f.get('Vocal', {}).get('uid', '');
    }

    // ¿La cuenta indicada puede ocupar ese cupo, hoy? Por cargo o por atribución
    // concedida. Lee el documento de la otra cuenta, como hace la app.
    function ocupaCupo(uidCupo, cupo) {
      let p = get(rutaUsuario(uidCupo)).data;
      let rol = rolDe(p);
      let prestamo = cupo == 'Director' ? 'cupo_direccion'
        : cupo == 'Secretario' ? 'cupo_secretaria'
        : cupo == 'Tesorero' ? 'cupo_tesoreria'
        : '';
      let propio = cupo == 'Director' ? rol in ['Director', 'Desarrollador']
        : cupo == 'Secretario' ? rol == 'Secretario'
        : cupo == 'Tesorero' ? rol == 'Tesorero'
        : rol == 'Vocal';
      return uidCupo != ''
        && exists(rutaUsuario(uidCupo))
        && p.get('activo', false) == true
        && (propio || atribucionVigente(p, prestamo));
    }

    function firmantesDistintos(d, cupos) {
      let uids = cupos.map(cupo -> d.get('firmas', {}).get(cupo, {}).get('uid', ''));
      return uids.size() == 3
        && uids[0] != '' && uids[1] != '' && uids[2] != ''
        && uids[0] != uids[1] && uids[0] != uids[2] && uids[1] != uids[2];
    }

    // La firma que entra en este update es la de quien llama, y sólo en el cupo
    // que su cargo (o su atribución) le permite ocupar.
    function firmaPropiaValida(d) {
      let antes = resource.data.get('firmas', {});
      let despues = d.get('firmas', {});
      let cupos = ['Director', 'Secretario', 'Tesorero', 'Vocal'];
      // Un solo cupo nuevo por update, y tiene que ser el del que firma.
      let nuevos = cupos.filter(cupo -> despues.get(cupo, {}).get('uid', '') != '' && antes.get(cupo, {}).get('uid', '') == '');
      if (nuevos.size() > 1) return false;
      if (nuevos.size() == 0) return true;
      let cupo = nuevos[0];
      let firma = despues.get(cupo, {});
      return cuentaVigente()
        && ocupaCupo(request.auth.uid, cupo)
        && firma.get('uid', '') == request.auth.uid
        && !cupos.exists(otro -> otro != cupo && antes.get(otro, {}).get('uid', '') == request.auth.uid);
    }

    // Qué cupo puede firmar mientras el acta está en solicitud de apertura.
    function cupoAutorizaApertura(d) {
      let antes = resource.data.get('firmas', {});
      let despues = d.get('firmas', {});
      return ['Tesorero', 'Vocal'].exists(cupo ->
        !(despues.get(cupo, {}).get('uid', '') != '' && antes.get(cupo, {}).get('uid', '') == ''));
    }

    function transicionEdicionActaValida() {
      let nuevo = request.resource.data;
      let anterior = resource.data;
      let campos = nuevo.diff(anterior).affectedKeys();
      return (
        // (a) Pedir abrir el acta: se limpian las firmas y queda a espera del
        // doble check. Cualquier cargo que lea actas puede pedirla (Tesorería y
        // Vocalía piden, no autorizan).
        (
          anterior.get('estado', '') in ['Cerrada', 'Borrador']
          && nuevo.get('estado', '') == 'En_Solicitud_Edicion'
          && campos.hasOnly(camposDeFirma())
          && puedeVerActas()
          && nuevo.get('firmas', {}).size() == 0
        )
        // (b) Autorizar la apertura: Dirección y Secretaría con dos cuentas.
        // Tesorería y Vocalía pueden firmar su cupo en un borrador, pero no
        // autorizar la reapertura.
        || (
          anterior.get('estado', '') in ['En_Solicitud_Edicion', 'Borrador']
          && nuevo.get('estado', '') in ['En_Solicitud_Edicion', 'Borrador', 'Cerrada']
          && campos.hasOnly(camposDeFirma())
          && espejosCoherentes(nuevo)
          && firmaPropiaValida(nuevo)
          // En plena solicitud de apertura sólo Dirección y Secretaría firman: el
          // Tesorero vuelve a firmar más tarde, sobre el texto corregido.
          && (anterior.get('estado', '') != 'En_Solicitud_Edicion' || cupoAutorizaApertura(nuevo))
          && (
            nuevo.get('estado', '') != 'Borrador'
            || (
              ocupaCupo(nuevo.get('firmas', {}).get('Director', {}).get('uid', ''), 'Director')
              && ocupaCupo(nuevo.get('firmas', {}).get('Secretario', {}).get('uid', ''), 'Secretario')
              && nuevo.get('firmas', {}).get('Director', {}).get('uid', '') != nuevo.get('firmas', {}).get('Secretario', {}).get('uid', '')
            )
          )
          // El cierre exige los tres cupos obligatorios, en cuentas distintas y
          // todavía hábiles. Con eso no hay acta que se cierre con una sola mano.
          && (
            nuevo.get('estado', '') != 'Cerrada'
            || (
              firmantesDistintos(nuevo, ['Director', 'Secretario', 'Tesorero'])
              && ocupaCupo(nuevo.get('firmas', {}).get('Tesorero', {}).get('uid', ''), 'Tesorero')
              && anterior.get('version', 0) + 1 >= nuevo.get('version', 0)
            )
          )
        )
        // (c) Guardar una edición ya autorizada: se reescribe el texto, sube la
        // versión, se guarda el respaldo y las firmas de cierre se limpian para
        // que los tres cupos vuelvan a firmar sobre el texto nuevo.
        || (
          anterior.get('estado', '') == 'Borrador'
          && nuevo.get('estado', '') == 'Borrador'
          && puedeRedactarActas()
          && ocupaCupo(anterior.get('firmas', {}).get('Director', {}).get('uid', ''), 'Director')
          && ocupaCupo(anterior.get('firmas', {}).get('Secretario', {}).get('uid', ''), 'Secretario')
          && anterior.get('firmas', {}).get('Director', {}).get('uid', '') != anterior.get('firmas', {}).get('Secretario', {}).get('uid', '')
          && campos.hasOnly(camposDeFirma().concat(['temasTratados', 'acuerdos', 'backupAnterior', 'titulo', 'fechaReunion', 'eventoId', 'fotoManuscritaUrl']))
          && nuevo.get('version', 0) == anterior.get('version', 0) + 1
          && nuevo.get('firmas', {}).size() == 0
          && espejosCoherentes(nuevo)
        )
      );
    }

    match /actas/{id} {
      allow read: if puedeVerActas();
      allow create: if puedeRedactarActas()
        && noEliminado('actas', id)
        && request.resource.data.get('estado', '') == 'Borrador'
        && request.resource.data.get('firmas', {}).size() == 0
        && request.resource.data.get('version', 0) == 1;
      allow delete: if false;
      allow update: if sinEliminacionPendiente('actas', id) && transicionEdicionActaValida();
    }

    // ── Libro de documentos institucionales ──
    match /documentos/{id} {
      allow read: if puedeVerDocumentos();
      allow create: if puedeSubirDocumentos() && noEliminado('documentos', id);
      allow update: if puedeSubirDocumentos() && sinEliminacionPendiente('documentos', id);
      allow delete: if false;
    }

    // Adjuntos de actividades: se mantienen fuera de /eventos para que el rol
    // Miembro pueda consultar el calendario sin obtener enlaces a documentos
    // administrativos. El Miembro ve los de las actividades donde está citado,
    // y no los puede editar.
    function convocadoA(eventoId) {
      let ficha = perfil().get('integranteId', '');
      let e = get(/databases/$(database)/documents/eventos/$(eventoId)).data;
      let cuerda = exists(rutaFicha(ficha)) ? get(rutaFicha(ficha)).data.get('cuerda', '') : '';
      return eventoId != '' && exists(/databases/$(database)/documents/eventos/$(eventoId)) && ficha != '' && (
        e.get('tipoConvocatoria', '') == 'Todos'
        || (e.get('tipoConvocatoria', '') == 'Por Cuerda' && e.get('cuerdasConvocadas', []).hasAny([cuerda]))
        || (e.get('tipoConvocatoria', '') == 'Personalizada' && e.get('integrantesConvocadosIds', []).hasAny([ficha]))
      );
    }

    match /documentos_evento/{id} {
      // Lectura filtrada: un Miembro recibe sólo los adjuntos de las actividades
      // donde está citado (la regla se evalúa por documento, por eso consulta la
      // convocatoria en vez de confiar en el que pide). Escribir es de agenda.
      allow read: if esGestion() || (activo() && convocadoA(resource.data.get('eventoId', '')));
      allow write: if puedeAgenda();
    }

    // Un dispositivo sólo registra o elimina su propio token de push. La
    // lectura global y el envío los ejecuta Firebase Admin desde el cron, que no
    // está sujeto a estas reglas.
    match /dispositivos_notificaciones/{id} {
      allow create: if activo() && request.resource.data.uid == request.auth.uid;
      allow get, delete: if activo() && resource.data.uid == request.auth.uid;
      allow update: if activo()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow list: if false;
    }

    // ──────────────────────────── Avisos ────────────────────────────

    // Bandeja de paso: la app deja el aviso y el servidor lo reparte en
    // usuarios/{uid}/avisos. Las lecturas personales viven en privado/lecturas.
    match /notificaciones/{id} {
      allow read, write: if esGestion();
      allow delete: if false;
    }

    // ─────────────────── Candado final: todo lo demás, negado ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
